# Sub2API 标定器环境变量（供 deploy/cc-calibrate.service 的 EnvironmentFile 使用）
# 部署时复制到 /etc/sub2api/cc-calibrate.env 并填好；含密钥，不要提交到仓库。

# 网关地址。标定器与网关同机时用本地回环即可（按你的实际映射端口调整）。
GATEWAY_URL=http://127.0.0.1:8080

# 后台「设置 → 网关服务 → Admin API Key」生成/复制的 key（发布标定 profile 用，x-api-key）。
ADMIN_API_KEY=

# 可选：锁定要标定/伪装的 CLI 版本；留空则跟随 npm latest 自动追新。
# CC_VERSION=2.1.211

# 可选：标定模型族矩阵（默认 haiku sonnet opus fable）。
# CC_CALIBRATE_MODELS=haiku sonnet opus fable
