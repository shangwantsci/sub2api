# Customer-specific immutable/mutable GHCR image tag.
SUB2API_CUSTOMER_IMAGE=ghcr.io/your-org/sub2api-customer-customer-id:0.1.156

# HTTPS endpoint of the operator-controlled license server.
DEPLOYMENT_LICENSE_SERVER_URL=https://license.example.com

# One-time code. Required only for the first successful activation. After the
# lease and instance identity are persisted under ./data/license it may be
# removed from .env.
DEPLOYMENT_LICENSE_ACTIVATION_CODE=

# Defaults: renew hourly, 10s network timeout, 6h outage grace.
DEPLOYMENT_LICENSE_RENEWAL_INTERVAL_SECONDS=3600
DEPLOYMENT_LICENSE_REQUEST_TIMEOUT_SECONDS=10
DEPLOYMENT_LICENSE_GRACE_PERIOD_SECONDS=21600

# Normally blank because customer release images pin the Ed25519 public key at
# build time through DEPLOYMENT_LICENSE_PUBLIC_KEY repository variable.
DEPLOYMENT_LICENSE_PUBLIC_KEY=

# Optional but recommended: immutable image digest deployed to this customer.
# Example: sha256:...
DEPLOYMENT_LICENSE_IMAGE_DIGEST=
