# =============================================================================
# Sub2API 公司部署 .env 模板
# =============================================================================
# 用法：
#   cp .env.example .env
#   chmod 600 .env          # 内含数据库密码与密钥，不要给其他用户读权限
#
# 这是一份精简模板，只列全新机器必须或强烈建议设置的项。完整可调项见
# deploy/.env.example（那份有 700+ 行，绝大多数保持默认即可）。
#
# 生成随机密钥：openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# 应用镜像（必填）
# -----------------------------------------------------------------------------
# 由 company-image.yml 构建、docker load 导入的本地 tag。
# 每次升级改成新的 <版本>-<commit>，旧 tag 保留即可作为回滚点。
# 这个 tag 不在任何 registry 里，所以本机禁止执行 docker compose pull sub2api。
SUB2API_IMAGE=sub2api-company:0.1.156-5670fce7c

# -----------------------------------------------------------------------------
# 监听地址（必填）—— 同时是 NewAPI 的接入点
# -----------------------------------------------------------------------------
# 本机的 NewAPI 是 systemd 原生服务（不在容器里），所以它以宿主机进程身份
# 通过回环访问号池。这个端口就是整条接线：
#
#   NewAPI 渠道 Base URL = http://127.0.0.1:18080
#
# 同一个端口也用于访问管理后台，走 SSH 隧道：
#   ssh -N -L 18080:127.0.0.1:18080 root@<公司主机>
#   然后在本地浏览器打开 http://localhost:18080
#
# 绝对不要改成 0.0.0.0——管理后台会以明文 HTTP 暴露在公网上，
# 而且这台机器的 ufw 并不会挡住 Docker 发布的端口。
BIND_HOST=127.0.0.1
SERVER_PORT=18080

# -----------------------------------------------------------------------------
# 数据库（POSTGRES_PASSWORD 必填，缺失时 compose 直接拒绝启动）
# -----------------------------------------------------------------------------
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
POSTGRES_DB=sub2api

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# 留空表示不设密码。Redis 未映射到宿主机端口，仅在 compose 内网可达；
# 若宿主机上还跑着别的容器，建议仍然设一个。
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 初始管理员（首次启动自动创建）
# -----------------------------------------------------------------------------
# 这是唯一能触达 /api/v1/admin/* 的身份。批量建号、数据导入等能力都由它把守
# （见 FORK_COMPANY_DEPLOY_CN.md 第 8 节），首次登录后立即改密码，
# 并且不要把这个账号给其他人。NewAPI 用的是普通 API Key，不是这个。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 固定密钥（强烈建议填，留空会每次启动随机生成）
# -----------------------------------------------------------------------------
# JWT_SECRET 留空 -> 每次重启所有人登录态失效。
JWT_SECRET=
# TOTP_ENCRYPTION_KEY 留空 -> 每次重启已绑定的 2FA 全部失效，用户无法登录。
TOTP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 其它
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
SERVER_MODE=release

# 访问 GitHub（在线更新检查、价格表拉取）的代理，机器不能直连时填。
# 例：http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
UPDATE_PROXY_URL=
